[Unit]
Description=KasmVNC 浏览器远程桌面（xfce4）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
# systemd 默认 PATH 不含 nix bin；@path@ 由激活脚本注入（kasmvnc + xfce 组件 + dbus + xauth/xkbcomp）
Environment=PATH=@path@
ExecStart=@kasmvnc@/bin/kasmvncserver -fg :1 -geometry 1920x1080 -select-de manual
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
