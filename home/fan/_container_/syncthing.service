[Unit]
Description=Syncthing（P2P 文件同步，仅 ~/share）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStart=@syncthing@/bin/syncthing serve --no-browser --config=/root/.config/syncthing --data=/root/.local/state/syncthing
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
