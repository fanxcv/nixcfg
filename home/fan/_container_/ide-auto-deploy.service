[Unit]
Description=ide-auto-deploy（轮询 nixcfg 仓库，变更自动 nix run 激活）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
# systemd 默认 PATH 不含 nix bin；单用户 nix 装在 /nix/var/nix/profiles/default
Environment=PATH=/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/ide-auto-deploy.sh

[Install]
WantedBy=multi-user.target
